{
  "name": "q_rice",
  "version": "1.0.0",
  "description": "Q_Rice — Instructor-Led Quiz Management System",
  "scripts": {
    "dev": "node server.js",
    "build": "next build && mkdir -p .next/server/app/api/export/pdf/data && cp -r node_modules/pdfkit/js/data/* .next/server/app/api/export/pdf/data/",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "node scripts/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cookie": "^0.6.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.447.0",
    "next": "^14.2.14",
    "papaparse": "^5.4.1",
    "pdfkit": "^0.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.10",
    "@types/papaparse": "^5.3.14",
    "@types/pdfkit": "^0.13.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
